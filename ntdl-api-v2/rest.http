# Not to do list api

@baseUrl = http://localhost:8000/api/v1/tasks

### POST the task list 
POST {{baseUrl}} 
Content-Type: application/json


{ 
    "task": "coding",
    "hr" : 10,
    "type": "bad"
   

}

### GET the task list  
GET {{baseUrl}}

### Update the task list
PATCH  {{baseUrl}}
Content-Type: application/json

# {
#     "_id": "66a9bf9a09d52386176b3a13",
#       "type": "bad"
# }

### Delete the task list

DELETE  {{baseUrl}}
Content-Type: application/json

["6a89724bdfe282bc7afbc470",
"6a8bb6e519fa7a1bd2e51b7e",
"6a8bb90f19fa7a1bd2e51b80",
"6a949a536eb90e8cd3d2c739"]